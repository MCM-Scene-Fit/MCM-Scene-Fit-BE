# 없으면 메모리에 저장합니다. 배포할 때만 채우세요. (Supabase / Neon 등 Postgres 연결 문자열)
DATABASE_URL=

# 없으면 AI 설명 대신 규칙 엔진이 만든 문장을 그대로 돌려줍니다.
# 무료 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 장면 배경 이미지, 장소 선정, AI 인물 생성에 쓰입니다. 없으면 이 기능들이 전부 꺼집니다.
# 키 발급: https://platform.openai.com/api-keys (무료 등급은 하루 호출 수가 매우 적어
# 시연 중 금방 소진됩니다 — 결제 등록해서 등급을 올려 두는 걸 권장합니다.)
OPENAI_API_KEY=

PORT=8787
